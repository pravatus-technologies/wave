{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./",
    "strict": true,
    "paths": {
      "@components/*": ["components/*"],
      "@components/controls": ["components/controls/index"],
      "@constants": ["constants/index"],
      "@constants/*": ["constants/*"],
      "@constants/interfaces/*": ["constants/types/interfaces/*"],
      "@context": ["context/index"],
      "@context/*": ["context/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["hooks/*"],
      "@init": ["init/*"],
      "@services/*": ["services/*"],
      "@themes/*": ["themes/index"],
      "@utils/*": ["utils/*"],
      "@navigation/*": ["navigation/*"],
      "@env": ["node_modules/react-native-dotenv"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "env.d.ts"]
}
